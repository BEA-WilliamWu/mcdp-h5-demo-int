    </target>
    <target name="compile-java-project">
    	<echo message="Compiling ${project.path}"/>
    	<mkdir dir="${classes.dir}/${project.path}"/>
        <javac srcdir="../${project.path}/src" destdir="${classes.dir}/${project.path}" includeantruntime="false" listfiles="yes" encoding="cp1252" nowarn="on" compiler="modern" debug="on">
        	<classpath>
        		<path refid="java.classpath" />
        		<fileset dir="${jars.dir}" includes="*.jar"/>
        	</classpath>
        </javac>
    	<copy todir="${classes.dir}/${project.path}">
    		<fileset dir="../${project.path}/src">
    			<exclude name="**/*.java"/>
    		</fileset>
    	</copy>
    	<condition property="resources.dir.exists">
    		<available file="../${project.path}/resources" type="dir"></available>
    	</condition>
    	<antcall target="copy-resources">
    		<param name="project.path" value="${project.path}"/>
    	</antcall>
    	<echo message="Packaging ${project.path} into JAR"/>
    	<basename file="${project.path}" property="project.name"/>
    	<jar destfile="${jars.dir}/${project.name}.jar" basedir="${classes.dir}/${project.path}">
