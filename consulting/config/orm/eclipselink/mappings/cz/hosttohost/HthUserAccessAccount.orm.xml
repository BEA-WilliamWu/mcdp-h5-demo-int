<?xml version="1.0" encoding="UTF-8"?>
<!-- Effective Current and Savings/Time Deposit grants; A/I status enables soft replacement. -->
<entity-mappings xmlns="http://www.eclipse.org/eclipselink/xsds/persistence/orm" version="2.5">
  <entity class="com.ofss.digx.cz.bea.domain.hosttohost.entity.HthUserAccessAccount" name="HthUserAccessAccount">
    <table name="HTH_USER_ACCESS_ACCOUNT" schema="HTH_BEA"/>
    <attributes>
      <embedded-id attribute-type="com.ofss.digx.cz.bea.domain.hosttohost.entity.HthUserAccessAccountKey" name="key">
        <attribute-override name="id"><column name="ID"/></attribute-override>
      </embedded-id>
      <basic attribute-type="java.lang.String" name="partyId"><column name="PARTY_ID"/></basic>
      <basic attribute-type="java.lang.String" name="closeId"><column name="CLOSE_ID"/></basic>
      <basic attribute-type="java.lang.String" name="accessPartyId"><column name="ACCESS_PARTY_ID"/></basic>
      <basic attribute-type="java.lang.String" name="linkageType"><column name="LINKAGE_TYPE"/></basic>
      <basic attribute-type="java.lang.String" name="accountNumber"><column name="ACCOUNT_NUMBER"/></basic>
      <basic attribute-type="java.lang.String" name="accountNumberFormatted"><column name="ACCOUNT_NUMBER_FORMATTED"/></basic>
      <basic attribute-type="java.lang.String" name="productCode"><column name="PRODUCT_CODE"/></basic>
      <basic attribute-type="java.lang.String" name="accountType"><column name="ACCOUNT_TYPE"/></basic>
      <basic attribute-type="java.lang.String" name="currency"><column name="CURRENCY"/></basic>
      <basic attribute-type="java.lang.String" name="objectStatus"><column name="OBJECT_STATUS"/></basic>
      <basic attribute-type="java.lang.String" name="createdBy"><column name="CREATED_BY" updatable="false"/></basic>
      <basic attribute-type="com.ofss.fc.datatype.Date" name="creationDate"><column name="CREATION_DATE" updatable="false"/><convert>DateTime</convert></basic>
      <basic attribute-type="java.lang.String" name="lastUpdatedBy"><column name="LAST_UPDATED_BY"/></basic>
      <basic attribute-type="com.ofss.fc.datatype.Date" name="lastUpdatedDate"><column name="LAST_UPDATE_DATE"/><convert>DateTime</convert></basic>
    </attributes>
  </entity>
</entity-mappings>
