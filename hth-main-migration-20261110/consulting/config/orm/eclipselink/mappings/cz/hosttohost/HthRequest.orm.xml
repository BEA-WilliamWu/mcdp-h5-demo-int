<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<entity-mappings xmlns="http://www.eclipse.org/eclipselink/xsds/persistence/orm" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.5" xsi:schemaLocation="http://www.eclipse.org/eclipselink/xsds/persistence/orm http://www.eclipse.org/eclipselink/xsds/eclipselink_orm_2_5.xsd">
	<entity class="com.ofss.digx.cz.bea.domain.hosttohost.entity.HthRequest" name="HthRequest">
		<table name="HTH_MANAGEMENT_REQUEST" schema="HTH_BEA"/>
		<attributes>
			<embedded-id attribute-type="com.ofss.digx.cz.bea.domain.hosttohost.entity.HthRequestKey" name="key">
				<attribute-override name="id">
					<column name="ID"/>
				</attribute-override>
			</embedded-id>

			<basic attribute-type="java.lang.String" name="transactionId">
				<column name="TRANSACTION_ID"/>
			</basic>

			<basic attribute-type="java.lang.String" name="referenceNo">
				<column name="REFERENCE_NO"/>
			</basic>

			<basic attribute-type="java.lang.String" name="partyId">
				<column name="PARTY_ID"/>
			</basic>

			<basic attribute-type="java.lang.String" name="actionType">
				<column name="ACTION_TYPE"/>
			</basic>

			<basic attribute-type="java.lang.String" name="uamClientId">
				<column name="UAM_CLIENT_ID"/>
			</basic>

			<basic attribute-type="java.lang.String" name="hthStatus">
				<column name="HTH_STATUS"/>
			</basic>

			<basic attribute-type="java.lang.String" name="approvalFlowType">
				<column name="APPROVAL_FLOW_TYPE"/>
			</basic>

			<basic attribute-type="java.lang.String" name="objectStatus">
				<column name="OBJECT_STATUS"/>
			</basic>

			<basic attribute-type="java.lang.String" name="chargeAccount">
				<column name="CHARGE_ACCOUNT"/>
			</basic>

			<basic attribute-type="java.lang.String" name="createdBy">
				<column name="CREATED_BY" updatable="false"/>
			</basic>

			<basic attribute-type="com.ofss.fc.datatype.Date" name="creationDate">
				<column name="CREATION_DATE" updatable="false"/>
				<convert>DateTime</convert>
			</basic>

			<basic attribute-type="java.lang.String" name="lastUpdatedBy">
				<column name="LAST_UPDATED_BY"/>
			</basic>

			<basic attribute-type="com.ofss.fc.datatype.Date" name="lastUpdatedDate">
				<column name="LAST_UPDATE_DATE"/>
				<convert>DateTime</convert>
			</basic>
