              <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
              <stringProp name="HTTPSampler.connect_timeout">${__P(connect_timeout_ms,10000)}</stringProp>
              <stringProp name="HTTPSampler.response_timeout">${__P(response_timeout_ms,60000)}</stringProp>
              <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
              <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Per-page headers" enabled="true">
                <collectionProp name="HeaderManager.headers" />
              </HeaderManager>
              <hashTree />
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare body and fresh signature" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename" />
                <stringProp name="parameters" />
                <stringProp name="script">import groovy.json.JsonOutput
import org.apache.jmeter.protocol.http.control.Header
import java.security.KeyFactory
import java.security.Signature
import java.security.spec.PKCS8EncodedKeySpec

try {
def get={String k, String d='' -&gt; props.getProperty(k,d)}
int page=(vars.get('page_no') as int)+1
vars.put('page_no',page.toString()); vars.put('cursor_in',vars.get('cursor'))
def body=[accountNumber:vars.get('account'),fromDate:vars.get('from_date'),toDate:vars.get('to_date'),pageSize:vars.get('page_size') as int]
['account_type':'accountType','currency':'currency'].each{k,v -&gt; if(vars.get(k)) body[v]=vars.get(k)}
if(vars.get('cursor')) body.cursor=vars.get('cursor')
vars.put('body',JsonOutput.toJson(body))
vars.put('message_id',UUID.randomUUID().toString())
def hm=new org.apache.jmeter.protocol.http.control.HeaderManager()
def add={k,v -&gt; if(v) hm.add(new Header(k,v.toString()))}
add('Content-Type','application/json'); add('Accept','application/json')
add('Channel',get('channel','HTH')); add('Message-Id',vars.get('message_id'))
def token=System.getenv('HTH_TOKEN')?.trim()
assert token: 'Set HTH_TOKEN before starting JMeter'
def prefix=get('auth_prefix','Bearer').trim()
add('Authorization',prefix ? prefix+' '+token : token)
def extra=get('headers_file')
if(extra){ def h=new Properties(); new File(extra).withInputStream{h.load(it)}; h.each{k,v -&gt; add(k,v)} }
def mode=get('auth_mode','signed')
assert mode in ['signed','token']: 'auth_mode must be signed or token'
if(mode=='signed'){
 def client=get('client_id',System.getenv('HTH_CLIENT_ID') ?: '')
 assert client: 'client_id is required for BFF signing'
 def key=vars.getObject('signingKey')
 if(!key){
  def file=get('private_key_file',System.getenv('HTH_PRIVATE_KEY_FILE') ?: '')
  assert file: 'private_key_file is required for signed mode'
  def pem=new File(file).getText('UTF-8')
  assert pem.contains('BEGIN PRIVATE KEY'): 'Use PKCS8 PEM RSA private key'
  def der=Base64.decoder.decode(pem.replaceAll(/-----[^-]+-----/,'').replaceAll(/\s/,''))
  key=KeyFactory.getInstance('RSA').generatePrivate(new PKCS8EncodedKeySpec(der)); vars.putObject('signingKey',key)
 }
 def time=String.valueOf(System.currentTimeMillis()-(get('clock_skew_ms','1000') as long))
 def path=vars.get('signing_path') ?: vars.get('endpoint')
 def content='POST\n'+path+'\n\n'+time+'\n'+vars.get('body')
 def signer=Signature.getInstance('SHA256withRSA'); signer.initSign(key); signer.update(content.getBytes('UTF-8'))
 add('Client-Id',client); add('Request-Time',time); add('Request-Sign',Base64.encoder.encodeToString(signer.sign()))
}
sampler.setProperty(new org.apache.jmeter.testelement.property.TestElementProperty(org.apache.jmeter.protocol.http.sampler.HTTPSamplerBase.HEADER_MANAGER,hm))
// Optional dynamic gateway/DPoP hook: receives sampler, vars, props; never log credentials.
if(get('auth_hook')) new GroovyShell(this.binding).evaluate(new File(get('auth_hook')))
sampler.setName(vars.get('scenario')+' '+vars.get('phase')+' page')

} catch(Throwable e) {
 vars.put("journey_error","Request preparation failed: "+e.class.simpleName)
 throw new org.apache.jorphan.util.JMeterStopThreadException("Request preparation failed; check local credentials/configuration", e)
}
</stringProp>
              </JSR223PreProcessor>
              <hashTree />
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validate page and advance cursor" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename" />
                <stringProp name="parameters" />
                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.security.MessageDigest

def fail={String message -&gt;
 AssertionResult.setFailure(true); AssertionResult.setFailureMessage(message)
 vars.put('complete','false'); vars.put('journey_error',message); vars.put('more','false')
}
prev.setSampleLabel(vars.get('scenario')+' '+vars.get('phase')+' page')
vars.put('page_count','0')
try {
 if(!prev.isSuccessful()) { fail('HTTP/transport failure: '+prev.getResponseCode()); return }
 def r=new JsonSlurper().parseText(prev.getResponseDataAsString())
 assert r.responseCode?.toString()==props.getProperty('success_code','000'): 'Non-success business response'
 assert r.accountNumber==vars.get('account'): 'Response account mismatch'
 def p=r.pagination
 assert p instanceof Map &amp;&amp; p.hasMoreData instanceof Boolean &amp;&amp; p.transactions instanceof List: 'Invalid pagination schema'
 def rows=p.transactions
 assert rows.size()&lt;=(vars.get('page_size') as int): 'Page exceeds requested size'
 assert p.pageSize instanceof Number &amp;&amp; p.pageSize.intValue()==rows.size(): 'pagination.pageSize differs from returned count'
 vars.put('page_count',rows.size().toString())
 rows.each { row -&gt;
  assert row.date &amp;&amp; row.date&gt;=vars.get('from_date') &amp;&amp; row.date&lt;=vars.get('to_date'): 'Out-of-range or missing transaction date'
  def last=vars.getObject('lastDate'); assert last==null || row.date&lt;=last: 'Dates not descending'
  vars.putObject('lastDate',row.date)
  if(vars.get('currency')) assert row.currency==vars.get('currency'): 'Currency mismatch'
  // Full-row fingerprints flag exact repeats, not globally unique banking identity.
  def stable=new TreeMap(row)
  def hash=MessageDigest.getInstance('SHA-256').digest(JsonOutput.toJson(stable).getBytes('UTF-8')).encodeHex().toString()
  if(props.getProperty('check_duplicates','true')=='true') assert vars.getObject('seenRows').add(hash): 'Exact duplicate transaction row; reconcile identity'
 }
 int total=(vars.get('total') as int)+rows.size(); vars.put('total',total.toString())
 assert total&lt;=(vars.get('expected_count') as int): 'Returned count exceeds expected count'
 if(p.hasMoreData){
  assert rows: 'Empty page with hasMoreData=true'
  assert p.nextCursor instanceof String &amp;&amp; p.nextCursor==~ /\d{9}/: 'Missing or invalid nextCursor (expected 9 digits)'
  assert p.nextCursor!=vars.get('cursor') &amp;&amp; vars.getObject('seenCursors').add(p.nextCursor): 'Repeated cursor/no progress'
  assert (vars.get('page_no') as int)&lt;(props.getProperty('max_pages','1000') as int): 'max_pages reached before completion'
  vars.put('cursor',p.nextCursor)
 } else {
  assert total==(vars.get('expected_count') as int): 'Premature final page: total does not equal expected_count'
  vars.put('complete','true'); vars.put('more','false')
 }
 long elapsed=(System.nanoTime()-(vars.getObject('started') as long))/1000000L
 assert elapsed&lt;=(props.getProperty('max_journey_ms','300000') as long): 'Journey deadline exceeded'
} catch(Throwable e){ fail(e.getMessage()?.take(500) ?: 'Response validation failed') }
</stringProp>
              </JSR223Assertion>
              <hashTree />
              <ResultCollector guiclass="StatVisualizer" testclass="ResultCollector" testname="Measured pages - Aggregate Report" enabled="true">
                <boolProp name="ResultCollector.error_logging">false</boolProp>
                <boolProp name="saveHeaders">true</boolProp>
                <stringProp name="filename" />
              </ResultCollector>
              <hashTree />
            </hashTree>
          </hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Journey summary" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename" />
          <stringProp name="parameters" />
          <stringProp name="script">long started=vars.getObject('started') as long
long duration=(System.nanoTime()-started)/1000000L
SampleResult.setSampleLabel(vars.get('scenario')+' '+vars.get('phase')+' journey')
boolean ok=vars.get('complete')=='true' &amp;&amp; !vars.get('journey_error')
SampleResult.setSuccessful(ok)
SampleResult.setResponseCode(ok?'200':'500')
SampleResult.setResponseMessage(ok?'Complete traversal':vars.get('journey_error'))
SampleResult.setResponseData('pages='+vars.get('page_no')+',records='+vars.get('total')+',duration_ms='+duration,'UTF-8')
vars.put('journey_ms',duration.toString())
// Keep traversal duration separate from the summary sampler execution time.
// JTL elapsed is summary-script time; use journey_ms for the traversal duration.
if(!ok &amp;&amp; props.getProperty('stop_on_failure','true')=='true') SampleResult.setStopThread(true)
</stringProp>
        </JSR223Sampler>
        <hashTree />
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Pause between journeys" enabled="true">
          <stringProp name="ActionProcessor.action">1</stringProp>
          <stringProp name="ActionProcessor.target">0</stringProp>
          <stringProp name="ActionProcessor.duration">${__P(pause_ms,1000)}</stringProp>
        </TestAction>
        <hashTree />
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>