diff --git a/dsp-ms-support/dsp-ms-support-svc/src/test/java/com/hkbea/dsp/dto/CryptKeyDtoTest.java b/dsp-ms-support/dsp-ms-support-svc/src/test/java/com/hkbea/dsp/dto/CryptKeyDtoTest.java
