+-- HTH final first-production-deployment script, based on BCO main 2974edbf and QTES2 400c21c5.
+-- Baseline: released BCO + Inquiry only; none of the 13 HTH business tables exists.
+-- One file, ordinary DDL/DML. No historical story scripts need to be run first/afterwards.
+-- Oracle SQLcl / SQL*Plus script mode, UTF-8. Do not run just the selected current statement.
+-- Use a dedicated deployment session in the OBDX configuration schema; stop applications first.
+-- DBA prerequisites: HTH_BEA owner exists with quota, deployment session can CREATE/INDEX/COMMENT
+-- and GRANT on its tables. Runtime schema needs its existing BCO access plus section 19 grants.
+-- DDL/GRANT commits implicitly. This is FIRST INSTALL, not a rerunnable UAT upgrade.
+-- On any error: STOP; do not resume blindly. Inspect partial DDL before preparing recovery.
+-- Supply production values from the approved release configuration, not UAT credentials.
+-- No output/spooling of secrets. Existing DSP configuration is preserved by section 18.
+-- Password writes require HTTP 200 and DSP status 000000; never treat a business error as success.
+SET ECHO OFF
+SET VERIFY OFF
+SET FEEDBACK ON
+SET SQLBLANKLINES ON
+SET DEFINE ON
+WHENEVER SQLERROR EXIT SQL.SQLCODE ROLLBACK
+WHENEVER OSERROR EXIT FAILURE ROLLBACK
+ACCEPT HTH_RUNTIME_OWNER CHAR PROMPT 'HTH runtime database schema: '
+ACCEPT BM_MAKER_POLICY CHAR PROMPT 'Approved BM maker policy ID: '
+ACCEPT BM_APPROVER_POLICY CHAR PROMPT 'Approved BM approver policy ID: '
+ACCEPT HTH_CODE_KEY CHAR PROMPT 'Production AES-256 Code key (Base64): ' HIDE
+-- Reuse the original BM DSP configuration. Existing rows are preserved in section 18.
+ACCEPT DSP_MGMT_URL CHAR PROMPT 'Production DSP internal APIC base URL (BM and password APIs): '
+ACCEPT DSP_MGMT_CLIENT_ID CHAR PROMPT 'Existing BM DSP APIC client ID: ' HIDE
+ACCEPT DSP_MGMT_CLIENT_SECRET CHAR PROMPT 'Existing BM DSP APIC client secret: ' HIDE
+PROMPT Check: Supplied DSP defaults must be HTTPS with nonempty subscription credentials
+SELECT CASE WHEN '&&DSP_MGMT_URL' LIKE 'https://%' AND TRIM('&&DSP_MGMT_CLIENT_ID') IS NOT NULL
+  AND TRIM('&&DSP_MGMT_CLIENT_SECRET') IS NOT NULL THEN 1 ELSE 1/0 END AS CHECK_OK FROM DUAL;
+
+-- 00 / Stop on failed baseline checks BEFORE any DDL
+PROMPT Check: No new HTH tables may exist for this first-install script
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM ALL_TABLES WHERE OWNER='HTH_BEA' AND TABLE_NAME IN ('HTH_API_MASTER','HTH_API_URI','HTH_MANAGEMENT','HTH_UAM_CLIENT_REGISTRY','HTH_MANAGEMENT_API','HTH_MANAGEMENT_REQUEST','HTH_MANAGEMENT_REQUEST_API','HTH_CERTIFICATE','HTH_CERTIFICATE_REQUEST','HTH_USER_PROFILE','HTH_USER_ACCESS_ACCOUNT','HTH_USER_ACCESS_ACCOUNT_API','HTH_API_PASSWORD_CODE'));
+
+PROMPT Check: Required BCO task sources
+SELECT CASE WHEN N=7 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(DISTINCT ID) N FROM DIGX_CM_TASK WHERE ID IN ('CM_N_CC','MT_N_CUS','MT_N_UUS','MT_N_RUS','UAT_N_CA','UAT_N_UA','UAT_N_DA'));
+
+PROMPT Check: BCO authentication source UAT_N_CA
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_AU_MAPPING M JOIN DIGX_AU_MAPPING_PARAM P ON P.MAP_ID=M.ID WHERE M.TASK_ID='UAT_N_CA');
+
+PROMPT Check: BCO authentication natural key unique for UAT_N_CA
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT MAINTENANCE_ID,ENTITY_VALUE,ENTITY_TYPE,DETERMINANT_VALUE FROM DIGX_AU_MAPPING WHERE TASK_ID='UAT_N_CA' GROUP BY MAINTENANCE_ID,ENTITY_VALUE,ENTITY_TYPE,DETERMINANT_VALUE HAVING COUNT(*)>1));
+
+PROMPT Check: BCO authentication source UAT_N_UA
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_AU_MAPPING M JOIN DIGX_AU_MAPPING_PARAM P ON P.MAP_ID=M.ID WHERE M.TASK_ID='UAT_N_UA');
+
+PROMPT Check: BCO authentication natural key unique for UAT_N_UA
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT MAINTENANCE_ID,ENTITY_VALUE,ENTITY_TYPE,DETERMINANT_VALUE FROM DIGX_AU_MAPPING WHERE TASK_ID='UAT_N_UA' GROUP BY MAINTENANCE_ID,ENTITY_VALUE,ENTITY_TYPE,DETERMINANT_VALUE HAVING COUNT(*)>1));
+
+PROMPT Check: BCO authentication source UAT_N_DA
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_AU_MAPPING M JOIN DIGX_AU_MAPPING_PARAM P ON P.MAP_ID=M.ID WHERE M.TASK_ID='UAT_N_DA');
+
+PROMPT Check: BCO authentication natural key unique for UAT_N_DA
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT MAINTENANCE_ID,ENTITY_VALUE,ENTITY_TYPE,DETERMINANT_VALUE FROM DIGX_AU_MAPPING WHERE TASK_ID='UAT_N_DA' GROUP BY MAINTENANCE_ID,ENTITY_VALUE,ENTITY_TYPE,DETERMINANT_VALUE HAVING COUNT(*)>1));
+
+PROMPT Check: BCO Change Password entitlement source DIGX_AZ_POLICY_ENT_MAP
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_AZ_POLICY_ENT_MAP P JOIN DIGX_AZ_RESOURCE_ACTION R ON R.ENTITLEMENT_ID=P.ENTITLEMENT_ID WHERE R.RESOURCE_ID IN ('change-password','com.ofss.digx.app.user.service.User.changeCredentials'));
+
+PROMPT Check: BCO Change Password entitlement source DIGX_AZ_ENTGROUP_ENT_MAPPING
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_AZ_ENTGROUP_ENT_MAPPING P JOIN DIGX_AZ_RESOURCE_ACTION R ON R.ENTITLEMENT_ID=P.ENTITLEMENT_ID WHERE R.RESOURCE_ID IN ('change-password','com.ofss.digx.app.user.service.User.changeCredentials'));
+
+PROMPT Check: BM_MAKER_POLICY must be an existing approved policy
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_AZ_POLICY_APP_MAP WHERE POLICY_ID='&&BM_MAKER_POLICY');
+
+PROMPT Check: BM_APPROVER_POLICY must be an existing approved policy
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_AZ_POLICY_APP_MAP WHERE POLICY_ID='&&BM_APPROVER_POLICY');
+
+PROMPT Check: BCO CORPORATE/USER/EMAIL/en active template source
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_EP_EVT_REC_B R JOIN DIGX_EP_MSG_TMPL_B T ON T.COD_TMPL_ID=R.COD_MSG_TMPL_ID AND T.DETERMINANT_VALUE='OBDX_BU' WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='CORPORATE' AND R.SUBSCRIBER_VALUE='USER' AND R.TXT_DEST_TYP='EMAIL' AND R.LOCALE='en' AND T.OBJECT_STATUS='A' AND T.DESTINATION_TYPE=R.TXT_DEST_TYP);
+
+PROMPT Check: BCO CORPORATE/USER/EMAIL has one unconditional route per locale
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT R.LOCALE FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='CORPORATE' AND R.SUBSCRIBER_VALUE='USER' AND R.TXT_DEST_TYP='EMAIL' GROUP BY R.LOCALE HAVING COUNT(DISTINCT R.COD_MSG_TMPL_ID)<>1 OR COUNT(DISTINCT NVL(R.UNSECURE_MSG_TMPL_ID,'~'))<>1 OR COUNT(R.COD_MSG_TMPL_ID)<>COUNT(*) OR R.LOCALE IS NULL OR MAX(NVL(R.FLG_CONDITIONAL,'?'))<>'N'));
+
+PROMPT Check: BCO CORPORATE/USER/EMAIL primary and alternate templates must exist and be active
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT R.COD_MSG_TMPL_ID ID FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='CORPORATE' AND R.SUBSCRIBER_VALUE='USER' AND R.TXT_DEST_TYP='EMAIL' UNION SELECT R.UNSECURE_MSG_TMPL_ID FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='CORPORATE' AND R.SUBSCRIBER_VALUE='USER' AND R.TXT_DEST_TYP='EMAIL' AND R.UNSECURE_MSG_TMPL_ID IS NOT NULL) X WHERE NOT EXISTS (SELECT 1 FROM DIGX_EP_MSG_TMPL_B T WHERE T.COD_TMPL_ID=X.ID AND T.DETERMINANT_VALUE='OBDX_BU' AND T.OBJECT_STATUS='A' AND T.DESTINATION_TYPE='EMAIL'));
+
+PROMPT Check: BCO CORPORATE/USER/SMS/en active template source
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_EP_EVT_REC_B R JOIN DIGX_EP_MSG_TMPL_B T ON T.COD_TMPL_ID=R.COD_MSG_TMPL_ID AND T.DETERMINANT_VALUE='OBDX_BU' WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='CORPORATE' AND R.SUBSCRIBER_VALUE='USER' AND R.TXT_DEST_TYP='SMS' AND R.LOCALE='en' AND T.OBJECT_STATUS='A' AND T.DESTINATION_TYPE=R.TXT_DEST_TYP);
+
+PROMPT Check: BCO CORPORATE/USER/SMS has one unconditional route per locale
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT R.LOCALE FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='CORPORATE' AND R.SUBSCRIBER_VALUE='USER' AND R.TXT_DEST_TYP='SMS' GROUP BY R.LOCALE HAVING COUNT(DISTINCT R.COD_MSG_TMPL_ID)<>1 OR COUNT(DISTINCT NVL(R.UNSECURE_MSG_TMPL_ID,'~'))<>1 OR COUNT(R.COD_MSG_TMPL_ID)<>COUNT(*) OR R.LOCALE IS NULL OR MAX(NVL(R.FLG_CONDITIONAL,'?'))<>'N'));
+
+PROMPT Check: BCO CORPORATE/USER/SMS primary and alternate templates must exist and be active
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT R.COD_MSG_TMPL_ID ID FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='CORPORATE' AND R.SUBSCRIBER_VALUE='USER' AND R.TXT_DEST_TYP='SMS' UNION SELECT R.UNSECURE_MSG_TMPL_ID FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='CORPORATE' AND R.SUBSCRIBER_VALUE='USER' AND R.TXT_DEST_TYP='SMS' AND R.UNSECURE_MSG_TMPL_ID IS NOT NULL) X WHERE NOT EXISTS (SELECT 1 FROM DIGX_EP_MSG_TMPL_B T WHERE T.COD_TMPL_ID=X.ID AND T.DETERMINANT_VALUE='OBDX_BU' AND T.OBJECT_STATUS='A' AND T.DESTINATION_TYPE='SMS'));
+
+PROMPT Check: BCO PARTY/CUSTOMER/EMAIL/en active template source
+SELECT CASE WHEN N>0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_EP_EVT_REC_B R JOIN DIGX_EP_MSG_TMPL_B T ON T.COD_TMPL_ID=R.COD_MSG_TMPL_ID AND T.DETERMINANT_VALUE='OBDX_BU' WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='PARTY' AND R.SUBSCRIBER_VALUE='CUSTOMER' AND R.TXT_DEST_TYP='EMAIL' AND R.LOCALE='en' AND T.OBJECT_STATUS='A' AND T.DESTINATION_TYPE=R.TXT_DEST_TYP);
+
+PROMPT Check: BCO PARTY/CUSTOMER/EMAIL has one unconditional route per locale
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT R.LOCALE FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='PARTY' AND R.SUBSCRIBER_VALUE='CUSTOMER' AND R.TXT_DEST_TYP='EMAIL' GROUP BY R.LOCALE HAVING COUNT(DISTINCT R.COD_MSG_TMPL_ID)<>1 OR COUNT(DISTINCT NVL(R.UNSECURE_MSG_TMPL_ID,'~'))<>1 OR COUNT(R.COD_MSG_TMPL_ID)<>COUNT(*) OR R.LOCALE IS NULL OR MAX(NVL(R.FLG_CONDITIONAL,'?'))<>'N'));
+
+PROMPT Check: BCO PARTY/CUSTOMER/EMAIL primary and alternate templates must exist and be active
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (SELECT R.COD_MSG_TMPL_ID ID FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='PARTY' AND R.SUBSCRIBER_VALUE='CUSTOMER' AND R.TXT_DEST_TYP='EMAIL' UNION SELECT R.UNSECURE_MSG_TMPL_ID FROM DIGX_EP_EVT_REC_B R WHERE R.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND R.COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE' AND R.COD_ACTION_ID='A' AND R.SUBSCRIBER_TYPE='PARTY' AND R.SUBSCRIBER_VALUE='CUSTOMER' AND R.TXT_DEST_TYP='EMAIL' AND R.UNSECURE_MSG_TMPL_ID IS NOT NULL) X WHERE NOT EXISTS (SELECT 1 FROM DIGX_EP_MSG_TMPL_B T WHERE T.COD_TMPL_ID=X.ID AND T.DETERMINANT_VALUE='OBDX_BU' AND T.OBJECT_STATUS='A' AND T.DESTINATION_TYPE='EMAIL'));
+
+PROMPT Check: BCO template attribute bindings are unique and active
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM (
+ SELECT A.COD_MESS_TMPL_ID,A.COD_ATTR_ID FROM DIGX_EP_MSG_ATTR_B A
+ LEFT JOIN DIGX_EP_MSG_SRC_B S ON S.COD_MESS_TMPL_ID=A.COD_MESS_TMPL_ID AND S.COD_ATTR_ID=A.COD_ATTR_ID AND S.COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND S.DETERMINANT_VALUE='OBDX_BU'
+ LEFT JOIN DIGX_MD_SERVICE_ATTR M ON M.COD_SERVICE_ATTR_ID=S.COD_SERVICE_ATTR_ID AND M.OBJECT_STATUS='A'
+ WHERE A.DETERMINANT_VALUE='OBDX_BU' AND A.COD_MESS_TMPL_ID IN (
+ SELECT COD_MSG_TMPL_ID FROM DIGX_EP_EVT_REC_B WHERE COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE'
+ UNION SELECT UNSECURE_MSG_TMPL_ID FROM DIGX_EP_EVT_REC_B WHERE COD_ACT_ID='com.ofss.digx.app.access.service.account.party.user.UserAccountAccess.update' AND COD_EVENT_ID='USER_ACCOUNT_ACCESS_UPDATE')
+ GROUP BY A.COD_MESS_TMPL_ID,A.COD_ATTR_ID HAVING COUNT(M.COD_SERVICE_ATTR_ID)<>1));
+
+PROMPT Check: No new HTH event may be in a dispatcher recipient override list
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_CZ_FW_CONFIG_ALL_O WHERE PREFERENCE_NAME='DayOneConfig' AND DETERMINANT_VALUE='OBDX_BU' AND PROP_ID IN ('EMAIL_DISPATCHER_ALERT_EVENTID_LIST','SMS_DISPATCHER_ALERT_EVENTID_LIST') AND REGEXP_LIKE(PROP_VALUE,'(^|,) *HTH_(API_SERVICE|USER_ACCOUNT_ACCESS|API_PASSWORD)_','i'));
+
+PROMPT Check: Existing BCO high-risk list must be present
+SELECT CASE WHEN N=1 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_CZ_FW_CONFIG_ALL_O WHERE PROP_ID='SUSPICIOUS_HIGH_RISK_TASK_ID' AND PREFERENCE_NAME='DayOneConfig' AND DETERMINANT_VALUE='OBDX_BU');
+
+PROMPT Check: Supplied new Code encryption key is Base64 AES-256
+SELECT CASE WHEN REGEXP_LIKE(V,'^[A-Za-z0-9+/]{43}=$','c') AND UTL_RAW.LENGTH(UTL_ENCODE.BASE64_DECODE(UTL_RAW.CAST_TO_RAW(V)))=32 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT '&&HTH_CODE_KEY' V FROM DUAL);
+
+PROMPT Check: Existing HTH password configuration must not disable the feature
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_FW_CONFIG_ADAPTER_PROP_B WHERE HOST_ID='HthApiCredentialAdapterConfig' AND TRANSACTION_TYPE='HTH_API_PASSWORD' AND (PROP_ID='ENABLED' AND NVL(LOWER(TRIM(PROP_VALUE)),'?')<>'true'));
+
+PROMPT Check: Existing Code encryption key, if provisioned, must equal the approved release key
+SELECT CASE WHEN N=0 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM DIGX_FW_CONFIG_ADAPTER_PROP_B WHERE HOST_ID='HthApiCredentialAdapterConfig' AND TRANSACTION_TYPE='HTH_API_PASSWORD' AND PROP_ID='CODE_CIPHER_KEY' AND NVL(PROP_VALUE,'?')<>'&&HTH_CODE_KEY');
+
+PROMPT Check: Runtime owner exists
+SELECT CASE WHEN N=1 THEN 1 ELSE 1/0 END AS CHECK_OK
+FROM (SELECT COUNT(*) N FROM ALL_USERS WHERE USERNAME=UPPER('&&HTH_RUNTIME_OWNER'));
+SET DEFINE OFF
+
+-- ============================================================================
+-- 01 / Final HTH schema: first deployment only
+-- ============================================================================
+CREATE TABLE HTH_BEA.HTH_API_MASTER (
+  ID VARCHAR2(36) NOT NULL,
+  API_CODE VARCHAR2(64) NOT NULL,
+  API_NAME VARCHAR2(255) NOT NULL,
+  DISPLAY_ORDER NUMBER,
+  OBJECT_STATUS VARCHAR2(1) DEFAULT 'A' NOT NULL,
+  CREATED_BY VARCHAR2(255) NOT NULL,
+  CREATION_DATE DATE DEFAULT SYSDATE NOT NULL,
+  LAST_UPDATED_BY VARCHAR2(255) NOT NULL,
+  LAST_UPDATE_DATE DATE DEFAULT SYSDATE NOT NULL,
+  OBJECT_VERSION_NUMBER NUMBER DEFAULT 1 NOT NULL,
+  CONSTRAINT PK_HTH_API_MASTER PRIMARY KEY (ID),
+  CONSTRAINT UK_HTH_API_MASTER_CODE UNIQUE (API_CODE)
+);
+
+COMMENT ON TABLE HTH_BEA.HTH_API_MASTER IS 'HTH API name master table.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_API_MASTER.ID IS 'Primary key.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_API_MASTER.API_CODE IS 'Stable API code used by application logic.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_API_MASTER.API_NAME IS 'API name displayed on HTH authorization UI.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_API_MASTER.DISPLAY_ORDER IS 'Display order on HTH authorization UI.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_API_MASTER.OBJECT_STATUS IS 'A: active, I: inactive.';
+
+CREATE TABLE HTH_BEA.HTH_API_URI (
+  ID VARCHAR2(36) NOT NULL,
+  API_MASTER_ID VARCHAR2(36) NOT NULL,
+  API_URI VARCHAR2(512) NOT NULL,
+  DISPLAY_ORDER NUMBER,
+  OBJECT_STATUS VARCHAR2(1) DEFAULT 'A' NOT NULL,
+  CREATED_BY VARCHAR2(255) NOT NULL,
+  CREATION_DATE DATE DEFAULT SYSDATE NOT NULL,
+  LAST_UPDATED_BY VARCHAR2(255) NOT NULL,
+  LAST_UPDATE_DATE DATE DEFAULT SYSDATE NOT NULL,
+  OBJECT_VERSION_NUMBER NUMBER DEFAULT 1 NOT NULL,
+  CONSTRAINT PK_HTH_API_URI PRIMARY KEY (ID),
+  CONSTRAINT UK_HTH_API_URI_MASTER_URI UNIQUE (API_MASTER_ID, API_URI),
+  CONSTRAINT FK_HTH_API_URI_TO_API_MASTER FOREIGN KEY (API_MASTER_ID) REFERENCES HTH_BEA.HTH_API_MASTER(ID)
+);
+
+COMMENT ON TABLE HTH_BEA.HTH_API_URI IS 'HTH API URI mapping table.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_API_URI.API_MASTER_ID IS 'References HTH_BEA.HTH_API_MASTER.ID.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_API_URI.API_URI IS 'Actual HTH API URI authorized by the API Name.';
+
+CREATE TABLE HTH_BEA.HTH_MANAGEMENT (
+  ID VARCHAR2(36) NOT NULL,
+  PARTY_ID VARCHAR2(64) NOT NULL,
+  UAM_CLIENT_ID VARCHAR2(128),
+  CHARGE_ACCOUNT VARCHAR2(50),
+  HTH_STATUS VARCHAR2(16) NOT NULL,
+  APPROVAL_FLOW_TYPE VARCHAR2(32),
+  OBJECT_STATUS VARCHAR2(1) DEFAULT 'A' NOT NULL,
+  CREATED_BY VARCHAR2(255) NOT NULL,
+  CREATION_DATE DATE DEFAULT SYSDATE NOT NULL,
+  LAST_UPDATED_BY VARCHAR2(255) NOT NULL,
+  LAST_UPDATE_DATE DATE DEFAULT SYSDATE NOT NULL,
+  CONSTRAINT PK_HTH_MANAGEMENT PRIMARY KEY (ID),
+  CONSTRAINT UK_HTH_MANAGEMENT_PARTY UNIQUE (PARTY_ID),
+  CONSTRAINT UK_HTH_MANAGEMENT_UAM_CLIENT UNIQUE (UAM_CLIENT_ID)
+);
+
+COMMENT ON TABLE HTH_BEA.HTH_MANAGEMENT IS 'Current effective HTH setting by corporate party.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_MANAGEMENT.PARTY_ID IS 'Corporate party ID.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_MANAGEMENT.UAM_CLIENT_ID IS 'Current effective UAM Client ID.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_MANAGEMENT.HTH_STATUS IS 'ENABLE or DISABLE.';
+
+COMMENT ON COLUMN HTH_BEA.HTH_MANAGEMENT.APPROVAL_FLOW_TYPE IS 'API approval flow type, e.g. STRAIGHT_THROUGH.';
+
+CREATE TABLE HTH_BEA.HTH_UAM_CLIENT_REGISTRY (
+  ID VARCHAR2(36) NOT NULL,
+  UAM_CLIENT_ID VARCHAR2(128) NOT NULL,
+  PARTY_ID VARCHAR2(64) NOT NULL,
+  STATUS VARCHAR2(16) NOT NULL,
+  ENABLE_TRANSACTION_ID VARCHAR2(64),
+  DISABLE_TRANSACTION_ID VARCHAR2(64),
+  OBJECT_STATUS VARCHAR2(1) DEFAULT 'A' NOT NULL,
+  CREATED_BY VARCHAR2(255) NOT NULL,
+  CREATION_DATE DATE DEFAULT SYSDATE NOT NULL,
+  LAST_UPDATED_BY VARCHAR2(255) NOT NULL,
+  LAST_UPDATE_DATE DATE DEFAULT SYSDATE NOT NULL,
