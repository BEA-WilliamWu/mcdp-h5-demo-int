+-- ============================================================================
+-- 08 / API Password setup and reset resources, task and adapter
+-- ============================================================================
+MERGE INTO DIGX_CM_TASK T
+USING (
+SELECT P.TARGET_TASK_ID AS ID, P.TARGET_TASK_NAME AS NAME, S.PARENT_ID, S.EXECUTABLE,
+       S.TASK_TYPE, S.MODULE_TYPE, S.OBJECT_STATUS
+  FROM DIGX_CM_TASK S
+  CROSS JOIN (
+    SELECT 'CM_N_HAP_SETUP' TARGET_TASK_ID,
+           'Set Up HTH API Password' TARGET_TASK_NAME FROM DUAL
+    UNION ALL
+    SELECT 'CM_N_HAP_RESET', 'Reset HTH API Password' FROM DUAL
+  ) P
+ WHERE S.ID = 'CM_N_CC'
+) S ON (T.ID = S.ID)
+WHEN MATCHED THEN UPDATE SET
+  T.NAME = S.NAME, T.PARENT_ID = S.PARENT_ID, T.EXECUTABLE = S.EXECUTABLE,
+  T.TASK_TYPE = S.TASK_TYPE, T.MODULE_TYPE = S.MODULE_TYPE,
+  T.OBJECT_STATUS = S.OBJECT_STATUS, T.LAST_UPDATED_BY = 'ofssuser',
+  T.LAST_UPDATED_DATE = SYSDATE, T.OBJECT_VERSION_NUMBER = NVL(T.OBJECT_VERSION_NUMBER, 0) + 1
+WHEN NOT MATCHED THEN INSERT
+  (ID, NAME, PARENT_ID, EXECUTABLE, TASK_TYPE, MODULE_TYPE, CREATED_BY,
+   CREATION_DATE, LAST_UPDATED_BY, LAST_UPDATED_DATE, OBJECT_STATUS, OBJECT_VERSION_NUMBER)
+VALUES
+  (S.ID, S.NAME, S.PARENT_ID, S.EXECUTABLE, S.TASK_TYPE, S.MODULE_TYPE,
+   'ofssuser', SYSDATE, 'ofssuser', SYSDATE, S.OBJECT_STATUS, 1);
+
