--- 09 / BCO authentication mappings copied to HTH task IDs only
--- ============================================================================
-INSERT INTO DIGX_AU_MAPPING
- (ID, MAINTENANCE_ID, ENTITY_VALUE, TASK_ID, ENTITY_TYPE, DETERMINANT_VALUE,
-  CREATED_BY, CREATION_DATE, LAST_UPDATED_BY, LAST_UPDATED_DATE, OBJECT_STATUS, OBJECT_VERSION_NUMBER)
- SELECT TO_CHAR((SELECT NVL(MAX(CASE WHEN REGEXP_LIKE(ID,'^[0-9]+$') THEN TO_NUMBER(ID) END),0)
- FROM DIGX_AU_MAPPING) + ROW_NUMBER() OVER (ORDER BY M.ID)),
- M.MAINTENANCE_ID, M.ENTITY_VALUE, 'UAT_N_HUA_NEW', M.ENTITY_TYPE, M.DETERMINANT_VALUE,
- USER, SYSDATE, USER, SYSDATE, M.OBJECT_STATUS, 1
- FROM DIGX_AU_MAPPING M WHERE M.TASK_ID = 'UAT_N_CA';
-
-INSERT INTO DIGX_AU_MAPPING_PARAM (MAP_ID, LEVEL_NO, AUTH_TYPE_ID)
- SELECT N.ID, P.LEVEL_NO, P.AUTH_TYPE_ID FROM DIGX_AU_MAPPING M
- JOIN DIGX_AU_MAPPING_PARAM P ON P.MAP_ID=M.ID
- JOIN DIGX_AU_MAPPING N ON N.TASK_ID='UAT_N_HUA_NEW'
- AND (N.MAINTENANCE_ID=M.MAINTENANCE_ID OR (N.MAINTENANCE_ID IS NULL AND M.MAINTENANCE_ID IS NULL))
- AND (N.ENTITY_VALUE=M.ENTITY_VALUE OR (N.ENTITY_VALUE IS NULL AND M.ENTITY_VALUE IS NULL))
- AND (N.ENTITY_TYPE=M.ENTITY_TYPE OR (N.ENTITY_TYPE IS NULL AND M.ENTITY_TYPE IS NULL))
- AND (N.DETERMINANT_VALUE=M.DETERMINANT_VALUE OR (N.DETERMINANT_VALUE IS NULL AND M.DETERMINANT_VALUE IS NULL))
- WHERE M.TASK_ID='UAT_N_CA';
