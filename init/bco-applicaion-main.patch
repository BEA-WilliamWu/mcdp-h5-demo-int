-  MAX_ATTEMPTS NUMBER(3) DEFAULT 5 NOT NULL,
-  CONSTRAINT CK_HTH_API_PWD_PURPOSE CHECK (PURPOSE IN ('SETUP','RESET')),
-  CONSTRAINT CK_HTH_API_PWD_ATTEMPTS CHECK (ATTEMPT_COUNT >= 0 AND MAX_ATTEMPTS > 0 AND ATTEMPT_COUNT <= MAX_ATTEMPTS),
