- VALUES ('HTH1288_ENABLE_EMAIL_en','EMAIL','HTH1288_ENABLE_EMAIL_en','HTH_API_SERVICE_SUBMIT_SUCCESS',TO_CLOB('<p>Dear Valued Customer,</p><p>Please be informed that H2H API service has been activated for your company.</p><p>Please complete the remaining setup and configuration activities in accordance with the Bank''s setup guidance before using the H2H API service.</p><p>For enquiries, please call our Merchant Services Hotline on (852) 2211 1056 during office hours.</p><p>Yours faithfully,</p><p>The Bank of East Asia, Limited</p><p>If there are any discrepancies between the English and Chinese versions of this email, the English version shall apply and prevail.</p><p>This is a system-generated email. Please do not reply to this email or via any hyperlinks in the message.</p><p>尊貴的客戶：</p><p>現特函通知，貴公司的H2H API服務已啟用。</p><p>請根據本行提供的設定指引完成所需設定及配置程序，方可使用H2H API服務。</p><p>如有查詢，請於辦公時間內致電本行商戶服務熱線：(852) 2211 1056。</p><p>謹啟</p><p>東亞銀行有限公司</p><p>中英文本文義如有歧異，概以英文本為準。</p><p>此乃電腦系統發出之電郵，請勿回覆此電郵或電郵內的超連結。</p>'),USER,SYSDATE,USER,SYSDATE,1,'A',TO_CLOB('BEA Corporate Online: H2H API Service Activated 東亞企業網上銀行：H2H API服務已啟用'),'CZ','OBDX_BU');
