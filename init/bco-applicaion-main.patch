-   LAST_UPDATED_DATE, OBJECT_STATUS, OBJECT_VERSION_NUMBER)
-VALUES
-   ((SELECT NVL(MAX(CASE WHEN REGEXP_LIKE(ID, '^[0-9]+$') THEN TO_NUMBER(ID) END), 0) + 1
