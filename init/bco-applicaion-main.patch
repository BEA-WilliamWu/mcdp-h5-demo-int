+INSERT INTO DIGX_AU_MAPPING
+ (ID, MAINTENANCE_ID, ENTITY_VALUE, TASK_ID, ENTITY_TYPE, DETERMINANT_VALUE,
+  CREATED_BY, CREATION_DATE, LAST_UPDATED_BY, LAST_UPDATED_DATE, OBJECT_STATUS, OBJECT_VERSION_NUMBER)
+ SELECT TO_CHAR((SELECT NVL(MAX(CASE WHEN REGEXP_LIKE(ID,'^[0-9]+$') THEN TO_NUMBER(ID) END),0)
+ FROM DIGX_AU_MAPPING) + ROW_NUMBER() OVER (ORDER BY M.ID)),
+ M.MAINTENANCE_ID, M.ENTITY_VALUE, 'UAT_N_HUA_NEW', M.ENTITY_TYPE, M.DETERMINANT_VALUE,
+ USER, SYSDATE, USER, SYSDATE, M.OBJECT_STATUS, 1
